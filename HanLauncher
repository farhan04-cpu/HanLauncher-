void cookPage() {
    content.removeAllViews();
    label(content, "AUTO COOK ASSISTANT");

    button(content, "MULAI TIMER 60 DETIK", () -> {
        new android.os.CountDownTimer(60000, 1000) {
            public void onTick(long ms) {
                toast("Sisa waktu: " + ms / 1000 + " detik");
            }
            public void onFinish() {
                toast("Waktu memasak selesai!");
            }
        }.start();
    });

    button(content, "KEMBALI", () -> neonTools());
}

