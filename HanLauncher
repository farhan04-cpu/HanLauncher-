public class MainActivity extends Activity {
    final int BG=Color.rgb(16,17,26), PANEL=Color.rgb(27,29,43), PURPLE=Color.rgb(155,140,255);
    final int WHITE=Color.rgb(242,243,250), MUTED=Color.rgb(160,164,184);
    LinearLayout root, content, nav;
    EditText amountInput, rateInput, worldInput, itemInput;
    TextView result;
    String page="Home";
    android.content.SharedPreferences prefs;

    public void onCreate(Bundle b) {
        super.onCreate(b);
        prefs=getSharedPreferences("hanlauncher", MODE_PRIVATE);
        getWindow().setStatusBarColor(BG);
        getWindow().setNavigationBarColor(BG);
        root=new LinearLayout(this); root.setOrientation(1); root.setBackgroundColor(BG);
        setContentView(root);
        header();
        ScrollView scroll=new ScrollView(this);
        content=new LinearLayout(this); content.setOrientation(1); content.setPadding(dp(18),dp(10),dp(18),dp(22));
        scroll.addView(content);
        root.addView(scroll,new LinearLayout.LayoutParams(-1,0,1));
        nav=new LinearLayout(this); nav.setPadding(dp(8),dp(8),dp(8),dp(8)); nav.setBackgroundColor(PANEL);
        root.addView(nav,new LinearLayout.LayoutParams(-1,dp(66)));
        showPage("Home");
    }
    int dp(float x){return (int)(x*getResources().getDisplayMetrics().density);}
    GradientDrawable shape(int color,int radius){
        GradientDrawable d=new GradientDrawable(); d.setColor(color); d.setCornerRadius(dp(radius)); return d;
    }
    TextView text(String s,int size,int color,boolean bold){
        TextView t=new TextView(this); t.setText(s); t.setTextSize(size); t.setTextColor(color);
        if(bold)t.setTypeface(Typeface.DEFAULT,Typeface.BOLD); return t;
    }
    void header(){
        LinearLayout h=new LinearLayout(this); h.setPadding(dp(20),dp(18),dp(20),dp(12));
        h.setGravity(Gravity.CENTER_VERTICAL);
        LinearLayout brand=new LinearLayout(this); brand.setOrientation(1);
        TextView logo=text("HANLAUNCHER",18,WHITE,true);
        TextView sub=text("GROWTOPIA COMPANION  •  V1.0",10,MUTED,true);
        brand.addView(logo); brand.addView(sub);
        h.addView(brand,new LinearLayout.LayoutParams(0,-2,1));
        TextView badge=text("HL",14,WHITE,true); badge.setGravity(Gravity.CENTER);
        badge.setBackground(shape(PURPLE,14)); h.addView(badge,new LinearLayout.LayoutParams(dp(42),dp(42)));
        root.addView(h);
    }
    void addSpace(LinearLayout box,int height){ View v=new View(this); box.addView(v,new LinearLayout.LayoutParams(1,dp(height))); }
    void label(LinearLayout box,String s){ TextView t=text(s,13,MUTED,true); t.setPadding(0,dp(12),0,dp(8)); box.addView(t); }
    LinearLayout card(LinearLayout parent){
        LinearLayout c=new LinearLayout(this); c.setOrientation(1); c.setPadding(dp(16),dp(15),dp(16),dp(15));
        c.setBackground(shape(PANEL,18)); LinearLayout.LayoutParams lp=new LinearLayout.LayoutParams(-1,-2); lp.bottomMargin=dp(12); parent.addView(c,lp); return c;
    }
    void showPage(String p){
        page=p; content.removeAllViews(); nav.removeAllViews();
        String[] names={"Home","Calc","Worlds","Inventory","Neon"};
        String[] icons={"⌂","◈","◎","▤","⚡"};
        for(int i=0;i<names.length;i++){
            final String n=names[i]; LinearLayout item=new LinearLayout(this); item.setGravity(Gravity.CENTER); item.setOrientation(1);
            TextView a=text(icons[i],20,p.equals(n)?PURPLE:MUTED,true); a.setGravity(Gravity.CENTER);
            TextView b=text(names[i],10,p.equals(n)?WHITE:MUTED,true); b.setGravity(Gravity.CENTER);
            item.addView(a); item.addView(b); item.setOnClickListener(v->showPage(n));
            nav.addView(item,new LinearLayout.LayoutParams(0,-1,1));
        }

