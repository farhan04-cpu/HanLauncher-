        if(p.equals("Home")) home(); else if(p.equals("Calc")) calculator(); else if(p.equals("Worlds")) worlds(); else inventory(); else if(p.equals("Neon")) neontoolspage();
    }
    void home(){
        TextView welcome=text("Control your game economy.",23,WHITE,true); content.addView(welcome);
        TextView desc=text("Tools sederhana untuk mengelola progres Growtopia.",13,MUTED,false); content.addView(desc);
        addSpace(content,18);
        LinearLayout hero=card(content); hero.setBackground(shape(Color.rgb(62,53,115),20));
        hero.addView(text("HANLAUNCHER",12,Color.rgb(220,215,255),true));
        addSpace(hero,6); hero.addView(text("Your companion dashboard",21,WHITE,true));
        addSpace(hero,5); hero.addView(text("Hitung aset, catat world, dan pantau hasil farming dalam satu tempat.",13,Color.rgb(222,219,245),false));
        label(content,"QUICK TOOLS");
        LinearLayout row=new LinearLayout(this);
        String[][] tools={{"Kalkulator","Hitung WL / DL / BGL"},{"World Manager","Simpan daftar world"}};
        for(int i=0;i<2;i++){
            final String target=i==0?"Calc":"Worlds"; LinearLayout c=new LinearLayout(this); c.setOrientation(1); c.setPadding(dp(13),dp(15),dp(8),dp(15)); c.setBackground(shape(PANEL,16));
            c.addView(text(i==0?"◈":"◎",22,PURPLE,true)); c.addView(text(tools[i][0],15,WHITE,true)); c.addView(text(tools[i][1],11,MUTED,false));
            LinearLayout.LayoutParams lp=new LinearLayout.LayoutParams(0,-2,1); lp.setMargins(0,0,dp(8),0); row.addView(c,lp); c.setOnClickListener(v->showPage(target));
        }
        content.addView(row);
        label(content,"APP NOTES");
        LinearLayout note=card(content); note.addView(text("HanLauncher adalah aplikasi pendamping mandiri. Data disimpan lokal di perangkat dan tidak terhubung ke server game.",13,MUTED,false));
    }
    EditText field(String hint,String value){
        EditText e=new EditText(this); e.setSingleLine(true); e.setTextColor(WHITE); e.setHintTextColor(MUTED); e.setHint(hint); e.setTextSize(14);
        e.setPadding(dp(12),dp(10),dp(12),dp(10)); e.setBackground(shape(Color.rgb(39,41,58),12)); if(value!=null)e.setText(value);
        LinearLayout.LayoutParams lp=new LinearLayout.LayoutParams(-1,dp(48)); lp.bottomMargin=dp(10); return e;
    }
    void button(LinearLayout box,String title,Runnable r){
        TextView b=text(title,14,WHITE,true); b.setGravity(Gravity.CENTER); b.setPadding(dp(12),dp(13),dp(12),dp(13)); b.setBackground(shape(PURPLE,12));
        LinearLayout.LayoutParams lp=new LinearLayout.LayoutParams(-1,dp(48)); lp.bottomMargin=dp(10); box.addView(b,lp); b.setOnClickListener(v->r.run());
    }
    double num(EditText e){try{return Double.parseDouble(e.getText().toString().trim());}catch(Exception ex){return 0;}}
    void calculator(){
        content.addView(text("Asset Calculator",23,WHITE,true));
        content.addView(text("Konversi nilai aset Growtopia.",13,MUTED,false));
        addSpace(content,14); LinearLayout c=card(content);
        label(c,"MASUKKAN JUMLAH");
        amountInput=field("Jumlah (contoh: 12500)",""); c.addView(amountInput);
        rateInput=field("Harga 1 WL dalam gems (contoh: 200)","200"); c.addView(rateInput);
        result=text("Hasil akan muncul di sini",14,WHITE,true); result.setPadding(0,dp(12),0,dp(8)); c.addView(result);
        button(c,"HITUNG ASET",()->{
            double gems=num(amountInput), rate=Math.max(1,num(rateInput));
            double wl=gems/rate, dl=wl/100, bgl=dl/100;
            result.setText(String.format(Locale.US,"%.2f WL   •   %.4f DL   •   %.6f BGL",wl,dl,bgl));
        });
        LinearLayout info=card(content); info.addView(text("Rumus konversi",15,WHITE,true)); info.addView(text("100 WL = 1 DL\n100 DL = 1 BGL\nHasil merupakan estimasi berdasarkan rate yang kamu masukkan.",12,MUTED,false));
    }
    void worlds(){
        content.addView(text("World Manager",23,WHITE,true));
        content.addView(text("Simpan dan kelola daftar world favorit.",13,MUTED,false)); addSpace(content,14);
        LinearLayout c=card(content); worldInput=field("Nama world",""); c.addView(worldInput);
        button(c,"＋ SIMPAN WORLD",()->{
            String w=worldInput.getText().toString().trim().toUpperCase(Locale.ROOT);
            if(w.isEmpty()){toast("Masukkan nama world.");return;}
            Set<String> set=new TreeSet<>(prefs.getStringSet("worlds",new HashSet<>()));
            set.add(w); prefs.edit().putStringSet("worlds",set).apply(); worldInput.setText(""); showPage("Worlds"); toast("World disimpan.");
        });
        label(content,"DAFTAR WORLD");
        Set<String> set=new TreeSet<>(prefs.getStringSet("worlds",new HashSet<>()));
        if(set.isEmpty()){LinearLayout empty=card(content); empty.addView(text("Belum ada world. Tambahkan world pertamamu di atas.",13,MUTED,false));}
        for(String w:set){
            LinearLayout item=card(content); LinearLayout r=new LinearLayout(this); r.setGravity(Gravity.CENTER_VERTICAL);
            r.addView(text("◎  "+w,15,WHITE,true),new LinearLayout.LayoutParams(0,-2,1));
            TextView del=text("HAPUS",10,Color.rgb(255,130,140),true); r.addView(del); del.setOnClickListener(v->{Set<String>s=new HashSet<>(prefs.getStringSet("worlds",new HashSet<>()));s.remove(w);prefs.edit().putStringSet("worlds",s).apply();showPage("Worlds");});
            item.addView(r);
        }
    }
    void inventory(){
        content.addView(text("Inventory Notes",23,WHITE,true));
        content.addView(text("Catat item dan jumlah aset secara manual.",13,MUTED,false)); addSpace(content,14);
        LinearLayout c=card(content); itemInput=field("Contoh: World Lock x 250",""); c.addView(itemInput);
        button(c,"＋ TAMBAH CATATAN",()->{
            String val=itemInput.getText().toString().trim(); if(val.isEmpty()){toast("Isi catatan item.");return;}
            ArrayList<String> list=new ArrayList<>(prefs.getStringSet("items",new HashSet<>()));
            list.add(val); prefs.edit().putStringSet("items",new HashSet<>(list)).apply(); itemInput.setText(""); showPage("Inventory"); toast("Catatan ditambahkan.");
        });
        label(content,"CATATAN INVENTARIS");
        ArrayList<String> list=new ArrayList<>(prefs.getStringSet("items",new HashSet<>()));
        if(list.isEmpty()){LinearLayout empty=card(content);empty.addView(text("Inventaris masih kosong.",13,MUTED,false));}
        for(String s:list){LinearLayout item=card(content); item.addView(text("▤  "+s,14,WHITE,true));}
        button(content,"HAPUS SEMUA CATATAN",()->new AlertDialog.Builder(this).setTitle("Hapus inventaris?").setMessage("Semua catatan item akan dihapus.").setNegativeButton("Batal",null).setPositiveButton("Hapus",(d,w)->{prefs.edit().remove("items").apply();showPage("Inventory");}).show());
    }
    void toast(String s){Toast.makeText(this,s,Toast.LENGTH_SHORT).show();}
}



void neonTools() {
    content.removeAllViews();
    label(content, "HANLAUNCHER NEON TOOLS");

    button(content, "AUTO COOK ASSISTANT", () -> cookPage());
